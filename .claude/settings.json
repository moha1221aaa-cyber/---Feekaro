{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x /usr/local/bin/graphify ] || exit 0; exec /usr/local/bin/graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x /usr/local/bin/graphify ] || exit 0; exec /usr/local/bin/graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=/home/claude/---feekaro/.claude/graphify-setup.sh; [ -f \"$f\" ] && (nohup sh \"$f\" >/dev/null 2>&1 &); exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
